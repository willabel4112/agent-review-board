<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- v2.3 联合首页前置: 常驻 ssh -L 隧道 (F1). 模板占位: __HOST__ / __LPORT__ / __LABEL__ / __ROOT__ -->
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-L</string><string>__LPORT__:127.0.0.1:8798</string>
    <string>__HOST__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__ROOT__/logs/tunnel-__HOST__.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/tunnel-__HOST__.log</string>
</dict></plist>
